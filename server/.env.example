# GhostSlot backend settings. Copy to server/.env and fill in.
# Never commit .env — it's in .gitignore.

# --- Required in production --------------------------------------------------
# Long random string (48+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# NODE_ENV=production   # turns on Secure/__Host- cookies, HSTS, strict origins

# --- AI (optional) -------------------------------------------------------------
# Gemini key from https://aistudio.google.com/apikey — used ONLY here on the
# server, for both CampusAI chat and the AI room search box.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash          # CampusAI chat (2.0-flash shut down Jun 2026)
# GEMINI_PARSE_MODEL=gemini-3.6-flash    # AI room search

# --- Accounts ------------------------------------------------------------------
# Demo account for judges (roll 23BCS10432). Set to "off" for real deployments.
# DEMO_ACCOUNT=on
# DEMO_PASSWORD=Ghost-Demo-2026
# Where the local account file lives (default: server/data/)
# DATA_DIR=

# --- Supabase (optional — leave blank to use the local file store) ------------
# Run supabase/migrations/0001_ghostslot_auth.sql in the Supabase SQL editor
# first. The service-role key is SECRET: server only, never in the frontend.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Demo logins -----------------------------------------------------------------
# Demo IDs (password = DEMO_PASSWORD): student DEMO_ROLL, faculty DEMO_FACULTY_ID
# DEMO_FACULTY_ID=E21045

# --- Web / deployment ------------------------------------------------------------
# PORT=8787
# Only if the frontend is hosted on a different domain (comma separated):
# ALLOWED_ORIGINS=https://ghostslot.example.com
# Behind a proxy/load balancer (Render, Railway, Nginx): number of hops
# TRUST_PROXY=1
